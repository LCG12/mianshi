{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "claims",
    "aspect_results",
    "clarifications"
  ],
  "properties": {
    "schema_version": {
      "const": "answer-draft/1.0"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "aspect_ids",
          "kind",
          "text",
          "evidence_ids",
          "premise_mention_ids",
          "depends_on_claim_ids",
          "calculation_id"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "aspect_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "kind": {
            "enum": [
              "rule",
              "conditional_application",
              "calculation"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "premise_mention_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "depends_on_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "calculation_id": {
            "type": "null"
          }
        }
      }
    },
    "aspect_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aspect_id",
          "disposition",
          "claim_ids",
          "gap_ids"
        ],
        "properties": {
          "aspect_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "addressed",
              "needs_user_info",
              "unavailable"
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "gap_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "clarifications": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "aspect_ids",
          "question"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "aspect_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnswerDraft design contract, not semantic validation",
  "$comment": "References, DAG, complete aspect coverage, dependency closure, user modality, capability checks and support entailment require application validation. calculation is reserved and disabled by policy."
}
