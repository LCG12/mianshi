# 复制为 .env 后由 load_settings 自动读取；启动环境变量优先。
# 模型绑定开关位于 configs/models.yaml；这里不保存登录密码。
LLM_BASE_URL=http://127.0.0.1:18082/llm
LLM_CHAT_PATH=/v1/chat/completions
LLM_MODEL=qwen3.5-27b
LLM_API_TOKEN=

# 卡 2 的三个推理接口。
INTENT_BASE_URL=http://127.0.0.1:18082
INTENT_PATH=/intent
INTENT_MODEL=Qwen3-1.7B
INTENT_API_TOKEN=
EMBEDDING_BASE_URL=http://127.0.0.1:18082
EMBEDDING_PATH=/embeddings
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_API_TOKEN=
RERANK_BASE_URL=http://127.0.0.1:18082
RERANK_PATH=/rerank
RERANK_MODEL=Qwen3-Reranker-0.6B
RERANK_API_TOKEN=
